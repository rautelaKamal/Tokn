# App
APP_NAME=Tokn Prompt Optimizer
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# CORS (JSON array format)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","chrome-extension://*"]

# Gemini (free: 250 req/day, 10 req/min at https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# API key auth for extension → backend (leave empty to disable in dev)
TOKN_API_KEY=

# Rate limiting (slowapi format: "N/period" — e.g. 10/minute, 100/hour)
RATE_LIMIT=10/minute

# Prompt cache
PROMPT_CACHE_MAXSIZE=256
PROMPT_CACHE_TTL_SECONDS=3600

# Token counting (tiktoken encoding for estimates)
TIKTOKEN_ENCODING=cl100k_base

# Cost estimation (USD per 1M tokens — Gemini 2.5 Flash pricing)
INPUT_COST_PER_MILLION=0.15
OUTPUT_COST_PER_MILLION=0.60

# JWT (phase 2)
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL (phase 2)
DATABASE_URL=postgresql+asyncpg://tokn:tokn@localhost:5432/tokn
