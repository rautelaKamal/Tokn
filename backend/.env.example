# App
APP_NAME=Tokn Prompt Optimizer
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# CORS (JSON array format)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","chrome-extension://*"]

# Groq (free: 14,400 req/day, 30 RPM with Llama 3.3 70B — get key at https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# API key auth for extension → backend (leave empty to disable in dev)
TOKN_API_KEY=

# Rate limiting (slowapi format: "N/period" — e.g. 10/minute, 100/hour)
RATE_LIMIT=10/minute

# Prompt cache
PROMPT_CACHE_MAXSIZE=256
PROMPT_CACHE_TTL_SECONDS=3600

# Token counting (tiktoken encoding for estimates)
TIKTOKEN_ENCODING=cl100k_base

# Cost estimation (USD per 1M tokens — Groq free tier, no cost)
INPUT_COST_PER_MILLION=0.0
OUTPUT_COST_PER_MILLION=0.0

# JWT (phase 2)
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL (phase 2)
DATABASE_URL=postgresql+asyncpg://tokn:tokn@localhost:5432/tokn
